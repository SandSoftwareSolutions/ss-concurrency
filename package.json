{
  "name": "@sandsoftwaresolutions/concurrency",
  "version": "0.1.1",
  "description": "Run async work with a maximum at once: limit, mapLimit, chunk and a mutex. Stoppable, ordered results.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "concurrency",
    "promise",
    "pool",
    "queue"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-concurrency.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-concurrency/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-concurrency#readme",
  "publishConfig": {
    "access": "public"
  }
}
